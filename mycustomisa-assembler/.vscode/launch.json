{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug assembler",
            "cargo": {
                "args": [
                    "build",
                    "--bin=mycustomisa-assembler"
                ],
                "filter": {
                    "name": "mycustomisa-assembler",
                    "kind": "bin"
                }
            },
            "args": ["test.asm"],
            "cwd": "${workspaceFolder}",
            "sourceLanguages": ["rust"]
        }
    ]
}