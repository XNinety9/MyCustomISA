import { Button, VerticalBox, HorizontalBox, ListView } from "std-widgets.slint";

struct RegEntry {
    name: string,
    value: string,
}

export component AppWindow inherits Window {
    title: "MyCustomISA VM Debugger";
    min-width: 940px;
    min-height: 560px;
    background: #1a1a1a;

    // CPU state
    in property <string>     pc-text:       "0x0000";
    in property <string>     sp-text:       "0xF4FF";
    in property <string>     instr-hex:     "0x0000";
    in property <string>     instr-decoded: "---";
    in property <[RegEntry]> registers;
    in property <bool>       flag-z;
    in property <bool>       flag-c;
    in property <bool>       flag-v;
    in property <bool>       flag-n;
    in property <bool>       flag-r;
    in property <image>      display-image;

    // Control state
    in property <bool> is-running: false;
    in property <bool> is-halted:  false;

    callback load-clicked();
    callback step-clicked();
    callback run-clicked();
    callback pause-clicked();

    VerticalBox {
        padding: 10px;
        spacing: 8px;

        // ── Toolbar ──────────────────────────────────────────────────
        HorizontalBox {
            spacing: 6px;
            alignment: start;

            Button { text: "Load Binary"; clicked => { root.load-clicked(); } }
            Button {
                text: "Step";
                enabled: !root.is-running && !root.is-halted;
                clicked => { root.step-clicked(); }
            }
            Button {
                text: "Run";
                enabled: !root.is-running && !root.is-halted;
                clicked => { root.run-clicked(); }
            }
            Button {
                text: "Pause";
                enabled: root.is-running;
                clicked => { root.pause-clicked(); }
            }
            Rectangle { horizontal-stretch: 1; }
            if root.is-halted: Text {
                text: "HALTED";
                color: #f55;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        // ── Instruction bar ──────────────────────────────────────────
        Rectangle {
            height: 38px;
            background: #252525;
            border-radius: 5px;
            HorizontalBox {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 18px;
                Text { text: "PC";            color: #555; font-family: "monospace"; vertical-alignment: center; }
                Text { text: root.pc-text;    color: #7ec8e3; font-family: "monospace"; font-weight: 700; vertical-alignment: center; }
                Rectangle { width: 1px; background: #444; }
                Text { text: root.instr-hex;     color: #888; font-family: "monospace"; vertical-alignment: center; }
                Rectangle { width: 1px; background: #444; }
                Text { text: root.instr-decoded; color: #dde; font-family: "monospace"; font-weight: 700; vertical-alignment: center; }
            }
        }

        // ── Registers | Flags | Display ──────────────────────────────
        HorizontalBox {
            spacing: 8px;

            // Register list
            Rectangle {
                background: #222;
                border-radius: 5px;
                horizontal-stretch: 1;
                VerticalBox {
                    padding: 10px;
                    spacing: 2px;
                    Text { text: "REGISTERS"; color: #555; font-size: 10px; font-weight: 700; }
                    ListView {
                        for r in root.registers: Rectangle {
                            height: 22px;
                            HorizontalBox {
                                padding: 2px;
                                spacing: 0px;
                                Text { text: r.name;  color: #667; font-family: "monospace"; font-size: 12px; width: 44px; vertical-alignment: center; }
                                Text { text: r.value; color: #ccd; font-family: "monospace"; font-size: 12px; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }

            // Flags + SP
            Rectangle {
                background: #222;
                border-radius: 5px;
                width: 115px;
                VerticalBox {
                    padding: 10px;
                    spacing: 5px;
                    alignment: start;
                    Text { text: "FLAGS"; color: #555; font-size: 10px; font-weight: 700; }
                    HorizontalBox {
                        spacing: 8px;
                        Text { text: "Z"; color: root.flag-z ? #4ec9b0 : #555; font-family: "monospace"; font-size: 13px; font-weight: 700; width: 18px; vertical-alignment: center; }
                        Text { text: root.flag-z ? "1" : "0"; color: root.flag-z ? #4ec9b0 : #555; font-family: "monospace"; font-size: 13px; vertical-alignment: center; }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        Text { text: "C"; color: root.flag-c ? #4ec9b0 : #555; font-family: "monospace"; font-size: 13px; font-weight: 700; width: 18px; vertical-alignment: center; }
                        Text { text: root.flag-c ? "1" : "0"; color: root.flag-c ? #4ec9b0 : #555; font-family: "monospace"; font-size: 13px; vertical-alignment: center; }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        Text { text: "V"; color: root.flag-v ? #4ec9b0 : #555; font-family: "monospace"; font-size: 13px; font-weight: 700; width: 18px; vertical-alignment: center; }
                        Text { text: root.flag-v ? "1" : "0"; color: root.flag-v ? #4ec9b0 : #555; font-family: "monospace"; font-size: 13px; vertical-alignment: center; }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        Text { text: "N"; color: root.flag-n ? #4ec9b0 : #555; font-family: "monospace"; font-size: 13px; font-weight: 700; width: 18px; vertical-alignment: center; }
                        Text { text: root.flag-n ? "1" : "0"; color: root.flag-n ? #4ec9b0 : #555; font-family: "monospace"; font-size: 13px; vertical-alignment: center; }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        Text { text: "R"; color: root.flag-r ? #4ec9b0 : #555; font-family: "monospace"; font-size: 13px; font-weight: 700; width: 18px; vertical-alignment: center; }
                        Text { text: root.flag-r ? "1" : "0"; color: root.flag-r ? #4ec9b0 : #555; font-family: "monospace"; font-size: 13px; vertical-alignment: center; }
                    }
                    Rectangle { height: 8px; }
                    Text { text: "SP"; color: #555; font-size: 10px; font-weight: 700; }
                    Text { text: root.sp-text; color: #7ec8e3; font-family: "monospace"; font-size: 12px; }
                }
            }

            // Display
            Rectangle {
                background: #111;
                border-radius: 5px;
                width: 276px;
                VerticalBox {
                    padding: 10px;
                    spacing: 6px;
                    alignment: start;
                    Text { text: "DISPLAY  128×128"; color: #555; font-size: 10px; font-weight: 700; }
                    Image {
                        source: root.display-image;
                        width: 256px;
                        height: 256px;
                        image-rendering: pixelated;
                    }
                }
            }
        }
    }
}
